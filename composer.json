{
    "name": "protendai/nativephp-mobile-ocr",
    "description": "Free, on-device OCR (text recognition) for NativePHP Mobile v4. ML Kit on Android, Apple Vision on iOS. Works offline.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": ["nativephp", "ocr", "text-recognition", "ml-kit", "vision", "laravel", "mobile"],
    "authors": [
        {
            "name": "Tendai Karuma",
            "email": "karumatendai@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Protendai\\Ocr\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Protendai\\Ocr\\OcrServiceProvider"
            ],
            "aliases": {
                "Ocr": "Protendai\\Ocr\\Facades\\Ocr"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
