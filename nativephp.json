{
    "name": "protendai/nativephp-mobile-ocr",
    "version": "0.1.0",
    "description": "Free, on-device OCR (text recognition) and document scanning for NativePHP Mobile v4. ML Kit on Android, Apple Vision on iOS.",
    "namespace": "Ocr",
    "keywords": [
        "ocr",
        "text recognition",
        "ml kit",
        "vision",
        "offline"
    ],
    "category": "utilities",
    "license": "MIT",
    "pricing": {
        "type": "free"
    },
    "author": {
        "name": "Tendai Karuma",
        "email": "karumatendai@gmail.com",
        "url": ""
    },
    "homepage": "",
    "repository": "",
    "funding": [],
    "platforms": [
        "android",
        "ios"
    ],
    "bridge_functions": [
        {
            "name": "Ocr.Recognize",
            "android": "com.protendai.plugins.ocr.OcrFunctions.Recognize",
            "ios": "OcrFunctions.Recognize",
            "description": "Recognise text in an image file. Async: the result arrives as TextRecognized or RecognitionFailed."
        },
        {
            "name": "Ocr.Scan",
            "android": "com.protendai.plugins.ocr.OcrFunctions.Scan",
            "ios": "OcrFunctions.Scan",
            "description": "Open the platform document scanner (back camera, edge detection, crop), then recognise the page. Async: TextRecognized, RecognitionFailed or ScanCancelled."
        }
    ],
    "android": {
        "min_version": 26,
        "permissions": [],
        "dependencies": {
            "implementation": [
                "com.google.mlkit:text-recognition:16.0.1",
                "com.google.android.gms:play-services-mlkit-document-scanner:16.0.0"
            ]
        }
    },
    "ios": {
        "min_version": "18.0",
        "dependencies": {
            "swift_packages": [],
            "pods": []
        }
    },
    "events": [
        "Protendai\\Ocr\\Events\\TextRecognized",
        "Protendai\\Ocr\\Events\\RecognitionFailed",
        "Protendai\\Ocr\\Events\\ScanCancelled"
    ],
    "service_provider": "Protendai\\Ocr\\OcrServiceProvider"
}
